<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Erro no Sistema</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-gradient: linear-gradient(145deg, #ff8a8a 0%, #f5f3ff 100%);
            --card-bg: rgba(255, 255, 255, 0.92);
            --text-primary: #3a1e26;
            --text-secondary: #705862;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(1.5rem, 4vw, 3rem);
            background: var(--bg-gradient);
            font-family: "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-primary);
        }

        main {
            width: min(460px, 100%);
        }

        .card {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border-radius: 26px;
            padding: clamp(2.2rem, 5vw, 3rem);
            box-shadow: 0 30px 60px -32px rgba(255, 80, 80, 0.6);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 138, 138, 0.18), rgba(255, 233, 233, 0.55));
            opacity: 0.8;
            pointer-events: none;
        }

        .card > * {
            position: relative;
            z-index: 1;
        }

        .badge {
            width: 68px;
            height: 68px;
            border-radius: 22px;
            margin: 0 auto 1.5rem auto;
            display: grid;
            place-items: center;
            background: rgba(255, 87, 87, 0.15);
            color: #e03131;
            font-size: 2rem;
        }

        h1 {
            margin: 0;
            font-size: clamp(1.6rem, 2.4vw, 2.1rem);
            font-weight: 700;
        }

        p {
            margin-top: 1rem;
            margin-bottom: 0;
            font-size: 1rem;
            color: var(--text-secondary);
        }

        a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-top: 1.8rem;
            padding: 0.8rem 1.5rem;
            border-radius: 999px;
            background: #e03131;
            color: #fff;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 18px 40px -25px rgba(224, 49, 49, 0.85);
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }

        a:hover {
            background: #b32020;
            transform: translateY(-2px);
            box-shadow: 0 22px 48px -25px rgba(179, 32, 32, 0.9);
        }
    </style>
</head>
<body>
    <main>
        <article class="card" role="alert">
            <div class="badge" aria-hidden="true">⚠️</div>
            <h1>Ocorreu um erro</h1>
            <p><%= mensagem %></p>
            <a href="/">Voltar ao início</a>
        </article>
    </main>
</body>
</html>
