<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Confirmação de Presença</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% if (Redirecionar) { %>
    <meta http-equiv="refresh" content="3; url=<%= URLDestino %>" />
    <% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            color-scheme: light;
            --bg-gradient: radial-gradient(circle at top left, #0f73ff, #5bd1b7 60%, #f4f9ff 100%);
            --card-bg: rgba(255, 255, 255, 0.9);
            --text-primary: #0d1c2e;
            --text-secondary: #506072;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(1.5rem, 4vw, 3rem);
            background: var(--bg-gradient);
            font-family: "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-primary);
        }

        main {
            width: min(480px, 100%);
        }

        .card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            border-radius: 28px;
            padding: clamp(2rem, 5vw, 3rem);
            box-shadow: 0 25px 55px -30px rgba(15, 115, 255, 0.65);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(15, 115, 255, 0.12), rgba(91, 209, 183, 0.18));
            opacity: 0.8;
            pointer-events: none;
        }

        .card > * {
            position: relative;
            z-index: 1;
        }

        .badge {
            width: 68px;
            height: 68px;
            border-radius: 22px;
            margin: 0 auto 1.5rem auto;
            display: grid;
            place-items: center;
            background: rgba(15, 115, 255, 0.12);
            color: #0f73ff;
            font-size: 2rem;
        }

        h1 {
            margin: 0;
            font-size: clamp(1.7rem, 2.4vw, 2.1rem);
            font-weight: 700;
        }

        h2 {
            margin: 0.75rem 0 1.5rem;
            font-size: clamp(1.1rem, 1.8vw, 1.3rem);
            color: var(--text-secondary);
            font-weight: 500;
        }

        p {
            font-size: 1.05rem;
            font-weight: 600;
            color: #0f73ff;
            margin: 0;
        }

        footer {
            margin-top: 2rem;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        @media (max-width: 420px) {
            .card {
                padding: 2rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <main>
        <article class="card" role="alert">
            <div class="badge" aria-hidden="true">🎉</div>
            <h1>Olá, <%= Nome %>!</h1>
            <h2><%= Mensagem %></h2>
            <% if (Horario) { %>
            <p><strong><%= Horario %></strong></p>
            <% } %>
            <% if (Redirecionar) { %>
            <footer>Você será redirecionado automaticamente em instantes.</footer>
            <% } %>
        </article>
    </main>
</body>
</html>
